# SMTP-Zugangsdaten für den automatischen Versand der Antwort-Mail.
# Kopieren nach ".env" und mit den echten Werten füllen — ".env" wird nicht
# versioniert (siehe .gitignore).
#
# Beispiel für ein Postfach mit App-Passwort (z. B. Gmail, Microsoft 365,
# oder das Skillsprinters-eigene Postfach):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deine-adresse@skillsprinters.de
SMTP_PASS=

# Absenderadresse, die die Kund:innen sehen (fällt sonst auf SMTP_USER zurück).
MAIL_FROM=deine-adresse@skillsprinters.de

# Optional: Kopie jeder Antwort-Mail an eine interne Adresse.
MAIL_BCC=
